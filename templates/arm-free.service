[Unit]
Description=Attempt an approved Oracle ARM instance launch
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=oracle-automation
Group=oracle-automation
EnvironmentFile=/etc/oracle-arm-automation.env
ExecStart=/usr/bin/flock -n /run/oracle-arm-automation.lock /opt/oracle-arm-automation/create-arm-free-once.sh
StandardOutput=journal
StandardError=journal

